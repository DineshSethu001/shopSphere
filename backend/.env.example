NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Set only when running behind a known reverse proxy; use its actual hop count.
# TRUST_PROXY_HOPS=1

MONGODB_URI=replace_with_your_mongodb_connection_string
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d

RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_a_separate_webhook_secret

CLOUDINARY_CLOUD_NAME=replace_with_your_cloud_name
CLOUDINARY_API_KEY=replace_with_your_api_key
CLOUDINARY_API_SECRET=replace_with_your_api_secret
